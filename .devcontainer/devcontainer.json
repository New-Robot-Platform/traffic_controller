{
    "name": "Bazel C++ DevContainer",
    "features": {
        "ghcr.io/devcontainers-community/features/bazel:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/apt-build-essential:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/cmake.org:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/clang-format:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/clang-tidy:1": {},
        "ghcr.io/devcontainer-community/devcontainer-features/sourceware.org-gdb:1": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cpptools-extension-pack"
            ],
            "settings": {
                "editor.formatOnSave": true,
                "C_Cpp.default.compilerPath": "/usr/bin/g++",
                "C_Cpp.default.cStandard": "c17",
                "C_Cpp.default.cppStandard": "c++20",
                "C_Cpp.default.includePath": [
                    "${workspaceFolder}/src",
                    "${workspaceFolder}/.vscode/asio-include"
                ],
                "C_Cpp.default.defines": [
                    "ASIO_STANDALONE"
                ]
            }
        }
    },
    "dockerComposeFile": [
        "../compose.yaml",
        "compose.yaml"
    ],
    "service": "devcontainer",
    "runServices": [
        "devcontainer",
        "mosquitto",
        "controller",
        "client"
    ],
    "workspaceFolder": "/workspaces/traffic_controller",
    "postStartCommand": "sh .devcontainer/setup-intellisense.sh"
}
